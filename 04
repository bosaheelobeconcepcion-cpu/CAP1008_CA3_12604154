#include <stdio.h>

int* runningSum(int* nums, int numsSize, int* returnSize) {
    int* resultado = (int*)malloc(numsSize * sizeof(int));
    *returnSize = numsSize;

    resultado[0] = nums[0];
    for (int i = 1; i < numsSize; i++) {
        resultado[i] = resultado[i - 1] + nums[i];
    }

    return resultado;
}
